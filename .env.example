# Firebase Client Configuration for BEL Trust Platform
# Replace with your Firebase project credentials from Firebase Console -> Project Settings
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyForBharatElectronicsLimited
VITE_FIREBASE_AUTH_DOMAIN=bel-trust-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bel-trust-platform
VITE_FIREBASE_STORAGE_BUCKET=bel-trust-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475610
VITE_FIREBASE_APP_ID=1:102938475610:web:9876543210abcdef

# Blockchain / DID Configuration
# "testnet" uses the built-in safe mock ledger (default, no setup needed).
# Set to a real RPC network name (e.g. "sepolia") + RPC URL to anchor on a
# public Ethereum testnet via ethers.js.
VITE_BLOCKCHAIN_NETWORK=testnet
VITE_BLOCKCHAIN_RPC_URL=

# BEL issuer identity used to sign employee Verifiable Credentials.
# In production this key lives in a KMS/HSM — never commit private keys.
VITE_ISSUER_DID=did:ethr:0xBEL0000000000000000000000000000000000000
