# ============================================================
# Firebase Client Configuration — BEL Trust Platform
# ============================================================

VITE_FIREBASE_API_KEY=AIzaSyDemoKeyForBharatElectronicsLimited
VITE_FIREBASE_AUTH_DOMAIN=bel-trust-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bel-trust-platform
VITE_FIREBASE_STORAGE_BUCKET=bel-trust-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475610
VITE_FIREBASE_APP_ID=1:102938475610:web:9876543210abcdef


# ============================================================
# Blockchain / DID Configuration
# ============================================================

# "testnet" uses the built-in safe mock ledger.
# No blockchain setup is required for local/demo mode.
#
# For a real Ethereum testnet such as Sepolia:
# VITE_BLOCKCHAIN_NETWORK=sepolia
# VITE_BLOCKCHAIN_RPC_URL=your_rpc_url

VITE_BLOCKCHAIN_NETWORK=testnet
VITE_BLOCKCHAIN_RPC_URL=


# ============================================================
# BEL Issuer Identity
# ============================================================

# BEL issuer identity used to sign employee
# Verifiable Credentials.
#
# Production:
# Store issuer private keys in a KMS/HSM.
# NEVER put private keys in this .env file.

VITE_ISSUER_DID=did:ethr:0xBEL0000000000000000000000000000000000000


# ============================================================
# Administrator Authentication
# ============================================================

# Only this email may use the email/password
# administrator portal.
#
# Employees must authenticate through
# DID wallet challenge/response.

VITE_ADMIN_EMAIL=admin@bel.in