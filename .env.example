# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Blockchain / DID Configuration
# "testnet" uses the built-in safe mock ledger (default, no setup needed).
# Set to a real RPC network name (e.g. "sepolia") + RPC URL to anchor on a
# public Ethereum testnet via ethers.js.
VITE_BLOCKCHAIN_NETWORK=testnet
VITE_BLOCKCHAIN_RPC_URL=

# BEL issuer identity used to sign employee Verifiable Credentials.
# In production this key lives in a KMS/HSM — never commit private keys.
VITE_ISSUER_DID=did:ethr:0xBEL0000000000000000000000000000000000000

# Only this email may use the email/password administrator portal.
# Every other user must authenticate via DID wallet challenge/response.
VITE_ADMIN_EMAIL=admin@bel.in