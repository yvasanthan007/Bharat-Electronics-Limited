# ─────────────────────────────────────────────────────────────────────────────
# BEL Asset NFT — deployment configuration (contracts/.env)
# THIS FILE IS GITIGNORED. Used ONLY by the CLI deploy script.
#
# SECURITY: use a THROWAWAY TESTNET-ONLY key funded from a faucet.
# Never use a mainnet key. This key is never shipped to the frontend and never
# stored in Firebase. The frontend signs all admin actions with MetaMask.
# ─────────────────────────────────────────────────────────────────────────────

# Raw private key of the TESTNET deployer wallet (0x…, 64 hex chars)
CONTRACT_DEPLOYER_KEY=

# RPC endpoints (public defaults provided)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# First NFT token id (spec example: BEL-LAP-001 -> 1023)
START_TOKEN_ID=1023

# Collection identity (defaults in deploy.ts)
NFT_CONTRACT_NAME=BEL Asset Ownership
NFT_CONTRACT_SYMBOL=BELA
