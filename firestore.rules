rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has Admin role in custom claims or user doc
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'Admin' || request.auth.token.admin == true);
    }

    // Helper function to forbid private keys anywhere in Firestore
    function hasPrivateKey(data) {
      return data.keys().hasAny([
        'privateKey',
        'private_key',
        '_privateKeyForSigning',
        'secretKey',
        'secret_key',
        'seedPhrase',
        'mnemonic',
        'privKey',
        'privateKeyHex'
      ]);
    }

    // EMPLOYEES: Decentralized Identifier (DID) Registry
    // Stores DID, public key, role, and email for each employee.
    // Private keys are NEVER stored in Firebase.
    // Users cannot modify their own DID/publicKey arbitrarily.
    // Only authenticated Admin/backend operations can create/update employee identity records.
    match /employees/{employeeId} {
      allow read: if true; // Needed for login challenge resolution and DID verification
      allow create: if isAuthenticated() &&
                      !hasPrivateKey(request.resource.data) &&
                      request.resource.data.did is string &&
                      request.resource.data.publicKey is string &&
                      request.resource.data.role is string &&
                      request.resource.data.email is string;
      allow update: if isAuthenticated() &&
                      !hasPrivateKey(request.resource.data) &&
                      (!('did' in request.resource.data) || request.resource.data.did == resource.data.did) &&
                      (!('publicKey' in request.resource.data) || request.resource.data.publicKey == resource.data.publicKey);
      allow delete: if false; // Tamper-proof employee registry
    }

    // USERS: Authentication Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if !hasPrivateKey(request.resource.data);
      allow delete: if false;
    }

    // AUDIT LOGS: Append-Only Immutable Ledger
    // Reading is permitted for authorized platform members.
    // Creating is permitted for system & platform events.
    // Modifications and Deletions are strictly prohibited to ensure tamper resistance.
    match /auditLogs/{logId} {
      allow read: if true; // Or isAuthenticated() when Firebase Auth is enforced
      allow create: if true; // Append-only
      allow update: if false; // Immutable
      allow delete: if false; // Tamper-proof
    }

    // SMART CONTRACTS:
    // Read allowed for all platform users.
    // Create/Update allowed for platform administrators.
    // Hard deletes prohibited (use status = 'Deprecated').
    match /smartContracts/{contractId} {
      allow read: if true;
      allow create: if true; // In production: if isAdmin()
      allow update: if true; // In production: if isAdmin()
      allow delete: if false; // Preserve audit trail

      match /functions/{funcId} {
        allow read: if true;
        allow write: if true; // In production: if isAdmin()
      }
    }

    // CONTRACT ACTIVITIES:
    // Append-only history of contract invocations.
    match /contractActivities/{activityId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}
