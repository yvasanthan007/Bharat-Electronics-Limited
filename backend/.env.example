# Server Environment
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bel_trust_db?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="bel_enterprise_defense_secret_key_2026_super_secure"
JWT_REFRESH_SECRET="bel_refresh_secret_key_2026_defense_grade"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Blockchain Gateway
BLOCKCHAIN_RPC_URL="https://rpc-testnet.trust.bel.co.in"
BLOCKCHAIN_CHAIN_ID=98234
